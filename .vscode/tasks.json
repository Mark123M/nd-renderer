{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DCMAKE_CXX_COMPILER=/usr/bin/g++-13",
                "-DCMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-13",
                "-DCMAKE_CUDA_COMPILER=/usr/local/cuda-13.0/bin/nvcc",
                "-G",
                "Ninja"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake-build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                //"--config",
                //"RelWithDebInfo",
                "-j"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": ["cmake-configure"]
        },
        {
            "label": "build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "cmake-configure",
                "cmake-build"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true // Keep this as the default build task
            }
        },
        {
            "label": "cmake-configure-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/release", // Dedicated build directory for Release
                "-DCMAKE_BUILD_TYPE=Release",       // Set build type to Release
                "-DCMAKE_CXX_COMPILER=/usr/bin/g++-13",
                "-DCMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-13",
                "-DCMAKE_CUDA_COMPILER=/usr/local/cuda-13.0/bin/nvcc",
                "-G",
                "Ninja"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake-build-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/release", // Build from the Release directory
                "-j"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": ["cmake-configure-release"]
        },
        {
            "label": "build-release", // A convenient label to build the Release configuration
            "dependsOrder": "sequence",
            "dependsOn": [
                "cmake-configure-release",
                "cmake-build-release"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "clean-release",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rfv",
                "${workspaceFolder}/build/release" // Clean the Release directory
            ],
            "problemMatcher": [],
        },
        // --- NEW: Task for Full ASan/LSan Run (No Debugger) ---
        {
            "label": "run-asan-full", // A descriptive label for this task
            "type": "shell",
            // The command to execute, including ASAN_OPTIONS and LSAN_OPTIONS
            "command": "ASAN_OPTIONS=\"detect_leaks=1\" LSAN_OPTIONS=\"verbosity=1:log_threads=1\" \"${workspaceFolder}/build/nd-raytracer\"",
           // "cwd": "${workspaceFolder}", // Run from the project root
            "problemMatcher": [],
            "group": "test", // You can classify it as a "test" task, or "none"
            "presentation": {
                "reveal": "always", // Always show the terminal for this task
                "panel": "new"     // Open a new terminal panel each time
            },
            "dependsOn": "build" // Ensure the RelWithDebInfo build is up-to-date before running
        },
        {
            "label": "cmake-configure-debug-gpu",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/debug",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_CXX_COMPILER=/usr/bin/g++-13",
                "-DCMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-13",
                "-DCMAKE_CUDA_COMPILER=/usr/local/cuda-13.0/bin/nvcc",
                "-G",
                "Ninja"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake-build-debug-gpu",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                //"--config",
                //"RelWithDebInfo",
                "-j"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": ["cmake-configure"]
        },
        {
            "label": "build-debug-gpu",
            "dependsOrder": "sequence",
            "dependsOn": [
                "cmake-configure-debug-gpu",
                "cmake-build-debug-gpu"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true // Keep this as the default build task
            }
        },
        {
            "label": "clean-debug",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rfv",
                "${workspaceFolder}/build/debug" // Clean the Release directory
            ],
            "problemMatcher": [],
        },
    ]
}